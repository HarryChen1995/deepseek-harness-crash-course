# Dependencies — reinstall with `npm install` at the course root.
node_modules/
.pnpm-store/

# Build / transpile output. This course runs .ts directly via tsx, so there
# should be nothing here; the entries guard against a stray `tsc` run.
dist/
lib/
build/
*.tsbuildinfo

# Logs, including the lesson-runner temp logs from scripts/try-lesson.sh
*.log
npm-debug.log*
logs/

# Local environment / secrets. Never commit an API key: the harness reads
# credentials from ~/.dsh/.credentials.yaml, which is outside this repo.
.env
.env.*
!.env.example
*.pem
*.key

# OS + editor cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# Test / coverage output
coverage/
.nyc_output/

# Scratch space for your own experiments — anything you drop in here stays
# local, so you can hack on a plugin without dirtying the course history.
scratch/
tmp/
